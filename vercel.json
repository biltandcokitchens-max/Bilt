{
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/roomplanner",
      "destination": "/roomplanner/",
      "permanent": true
    },
    {
      "source": "/planner",
      "destination": "/roomplanner/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/roomplanner/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
